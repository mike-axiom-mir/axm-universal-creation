  "system": {
    "schema": "axm.code-system/v0.1",
    "domain": "game",
    "initial_model": {
      "health": 10,
      "enemy": 9,
      "ammo": 3
    },
    "machine": {
      "schema": "axm.deterministic-state-machine/v0.1",
      "id": "combat-session",
      "states": [
        "ready",
        "running",
        "paused",
        "won",
        "lost"
      ],
      "initial_state": "ready",
      "transitions": [
        {
          "from": "ready",
          "event": "start",
          "to": "running",
          "effects": [
            {
              "type": "session-started"
            }
          ]
        },
        {
          "from": "running",
          "event": "attack",
          "to": "running",
          "effects": [
            {
              "type": "attack-feedback"
            }
          ]
        },
        {
          "from": "running",
          "event": "victory",
          "to": "won",
          "effects": [
            {
              "type": "victory"
            }
          ]
        },
        {
          "from": "running",
          "event": "hit",
          "to": "running",
          "effects": []
        },
        {
          "from": "running",
          "event": "defeat",
          "to": "lost",
          "effects": [
            {
              "type": "defeat"
            }
          ]
        },
        {
          "from": "running",
          "event": "pause",
          "to": "paused",
          "effects": []
        },
        {
          "from": "paused",
          "event": "resume",
          "to": "running",
          "effects": []
        },
        {
          "from": "running",
          "event": "reload",
          "to": "running",
          "effects": []
        },
        {
          "from": "won",
          "event": "reset",
          "to": "ready",
          "effects": []
        },
        {
          "from": "lost",
          "event": "reset",
          "to": "ready",
          "effects": []
        }
      ]
    },
    "bindings": [
      {
        "event": "start",
        "reducer": "idle"
      },
      {
        "event": "pause",
        "reducer": "idle"
      },
      {
        "event": "resume",
        "reducer": "idle"
      },
      {
        "event": "attack",
        "reducer": "strike",
        "guard": "canStrike",
        "routes": {
          "function": "afterStrike",
          "events": [
            "attack",
            "victory"
          ]
        }
      },
      {
        "event": "hit",
        "reducer": "hit",
        "guard": "canHit",
        "routes": {
          "function": "afterHit",
          "events": [
            "hit",
            "defeat"
          ]
        }
      },
      {
        "event": "reload",
        "reducer": "reload",
        "guard": "canReload"
      },
      {
        "event": "reset",
        "reducer": "reset"
      }
    ],
    "invariants": [
      {
        "id": "resource-bounds",
        "function": "validResources",
        "statement": "Health, enemy health and ammo stay within the declared whole-number bounds."
      }
    ],
