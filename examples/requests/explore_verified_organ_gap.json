{
  "kind": "explore-gap-candidate",
  "direction": "discover and test a detached verified organ-assembly capability from exact live contracts",
  "inputs": {
    "operation": "materialize-and-test",
    "path": "creations/spawned/generated-organ-composite",
    "request": {
      "kind": "verified-reusable-organ-static-web-project",
      "direction": "assemble exact executable organs and independently verify their emitted digest receipt",
      "inputs": {
        "path": "creations/generated/verified-organ-site",
        "replace": false,
        "assembly": {
          "id": "axm.example.verified-reusable-organ-site",
          "version": "1.0.0",
          "project_type": "static-web",
          "organs": [
            {
              "instance_id": "interaction-organ",
              "ref": "axm.web.interaction@1.0.0",
              "depends_on": [
                "theme-organ"
              ],
              "bindings": {
                "active_label": "Verified interaction awake",
                "state": "awake"
              }
            },
            {
              "instance_id": "theme-organ",
              "ref": "axm.web.theme@1.0.0",
              "depends_on": [
                "shell-organ"
              ],
              "bindings": {
                "background": "radial-gradient(circle at top, #33418f 0%, #15172b 48%, #070812 100%)"
              }
            },
            {
              "instance_id": "shell-organ",
              "ref": "axm.web.shell@1.0.0",
              "bindings": {
                "idle_label": "Wake verified organ",
                "title": "Receipt-discovered organs can compose"
              }
            }
          ]
        },
        "variables": {}
      }
    }
  }
}
