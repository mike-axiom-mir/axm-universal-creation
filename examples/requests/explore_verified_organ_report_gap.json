{
  "kind": "explore-gap-candidate",
  "direction": "discover and test a detached three-step organ creation, verification, and exact JSON evidence recipe",
  "inputs": {
    "operation": "materialize-and-test",
    "path": "creations/spawned/generated-organ-report-composite",
    "request": {
      "kind": "verified-reusable-organ-project-with-json-report",
      "direction": "assemble exact executable organs, independently verify their emitted digest receipt, and persist that exact evidence as JSON",
      "inputs": {
        "path": "creations/generated/verified-organ-report-site",
        "report_path": "creations/generated/verified-organ-report.json",
        "replace": false,
        "assembly": {
          "id": "axm.example.verified-reusable-organ-report-site",
          "version": "1.0.0",
          "project_type": "static-web",
          "organs": [
            {
              "instance_id": "interaction-organ",
              "ref": "axm.web.interaction@1.0.0",
              "depends_on": [
                "theme-organ"
              ],
              "bindings": {
                "active_label": "Verified report awake",
                "state": "awake"
              }
            },
            {
              "instance_id": "theme-organ",
              "ref": "axm.web.theme@1.0.0",
              "depends_on": [
                "shell-organ"
              ],
              "bindings": {
                "background": "radial-gradient(circle at top, #33418f 0%, #15172b 48%, #070812 100%)"
              }
            },
            {
              "instance_id": "shell-organ",
              "ref": "axm.web.shell@1.0.0",
              "bindings": {
                "idle_label": "Wake verified report organ",
                "title": "Bounded recipes preserve exact evidence"
              }
            }
          ]
        },
        "variables": {}
      }
    }
  }
}
