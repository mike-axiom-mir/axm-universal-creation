+    "truth": {"fit": true, "basis": "Exact sketch digests, sticker pins, assembly pins, structural residuals and repair receipts are revalidated; unavailable mesh-size evidence remains HOLD."},
+    "agency": {"fit": true, "basis": "The caller chooses every source sticker binding, override, placement, output identity/version/provenance and whether a proposed repair is saved."},
+    "continuity": {"fit": true, "basis": "Build, compare and repair receipts bind the exact sketch, source pins, source assembly and new immutable assembly version without rewriting prior versions."},
+    "wisdom-before-speed": {"fit": true, "basis": "Structural mismatches, unknown pins, missing/extra parts, parameterized repair ambiguity and unobserved dimensions hold or fail closed instead of being guessed through."}
+  }
+}
