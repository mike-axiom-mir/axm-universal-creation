+      "assembly": "exact immutable 3D assembly sticker pin",
+      "part_a": "first direct assembly child id",
+      "part_b": "second distinct direct assembly child id",
+      "pairs": "optional bounded explicit list of direct-part id pairs; omitted means bounded all-pairs scan",
+      "tolerance_m": "optional finite geometric tolerance in metres",
+      "sketch": "exact axm.design-sketch/v0.1 body",
+      "plan": "exact-sketch-bound axm.design-clearance-plan/v0.1 companion requirements"
+    }
+  },
+  "output_contract": {
+    "kind": "rest-pose-clearance-contact-evidence",
+    "contains": [
+      "broad-phase AABB lower-bound and overlap evidence",
+      "triangle-level minimum surface distance and closest point witnesses",
+      "SEPARATED, TOUCHING, PENETRATING, CONTACT_OR_INTERSECTION, or UNMEASURED relation",
+      "closed-surface inside witness before any PENETRATING claim",
+      "bounded all-pairs assembly scan",
+      "exact-sketch-bound minimum-clearance, contact, and no-penetration requirement results"
