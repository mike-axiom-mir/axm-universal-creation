+  "handles": ["creation-atlas", "atlas-creation"],
+  "input_contract": {
+    "required": [],
+    "required_by_operation": {
+      "get": ["id"], "closure": ["ids"], "plan": ["intent"],
+      "build": ["intent", "path"], "experience": ["memory"]
+    },
+    "properties": {
+      "operation": "summary, query, get, closure, plan, build or experience",
+      "intent": "purpose, exact direction, explicit goals, typed parameters and optional blueprint id; parameters can select atlas data",
+      "memory": "optional caller-selected persistent experience directory outside machine internals",
+      "plan_sha256": "optional expected plan identity; changed source, parameters or experience returns HOLD before writes"
+    }
+  },
+  "output_contract": {"kind": "atlas-knowledge-or-goal-bound-creation", "contains": ["source and evidence labels", "deterministic route and explicit gaps", "retained intent, construction, results and goal checks", "reusable measured search seeds"]},
+  "dependencies": [],
