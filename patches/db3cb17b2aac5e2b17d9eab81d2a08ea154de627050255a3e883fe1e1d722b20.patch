+
+    def test_point_filters_known_results(self):
+        cases = [({'type':'brightness','value':1},(255,255,255,255)),
+                 ({'type':'contrast','value':-1},(128,128,128,255)),
+                 ({'type':'saturation','value':0},(43,43,43,255)),
