+    "source": "src/axm_uc/creative_flow.py",
+    "runtime_bridge": "capabilities/platform-hands/shared/asset-hands/creative-flow-bridge.js"
+  },
+  "limitations": [
+    "V1 does not invent an execution plan from arbitrary prose. A goal without explicit steps returns deterministic candidates and HOLD_PLAN_REQUIRED.",
+    "Compatibility preflight proves plan structure, exact operation existence, dependencies and state-reference availability; individual hand implementations remain authoritative for their own schema and parameter validation at execution.",
