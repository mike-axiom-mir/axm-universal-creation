+}
+FINISHES = {
+    "factory": {"roughness_scale": 1.0, "roughness_bias": 0.0, "metallic_scale": 1.0},
+    "matte": {"roughness_scale": .55, "roughness_bias": .46, "metallic_scale": .82},
