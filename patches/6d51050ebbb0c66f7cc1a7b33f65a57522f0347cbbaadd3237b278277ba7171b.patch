+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "axm.asset-hand-benchmark-receipt/v1",
+  "title": "AXM Runtime-observed Asset Hand Benchmark Receipt",
+  "type": "object",
+  "required": [
+    "schema",
+    "version",
+    "id",
+    "digest",
+    "workload",
+    "environment",
+    "measurement_source",
+    "repetitions",
+    "execution",
+    "samples",
+    "statistics",
+    "measurements",
+    "budgets",
+    "checks",
+    "failures",
+    "status",
+    "scope",
+    "limitations"
+  ],
+  "properties": {
+    "schema": { "const": "axm.asset-hand-benchmark-receipt/v1" },
+    "version": { "const": "1.1.0" },
+    "id": { "type": "string", "pattern": "^benchmark-[a-f0-9]{24}$" },
+    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
+    "workload": {
+      "type": "object",
+      "required": ["id", "digest", "description", "observed_function_digest"],
+      "properties": {
+        "id": { "type": "string", "minLength": 1, "maxLength": 120 },
+        "digest": { "type": "string", "minLength": 1, "maxLength": 128 },
+        "description": { "type": "string", "minLength": 1, "maxLength": 500 },
+        "observed_function_digest": {
+          "type": ["string", "null"],
+          "pattern": "^[a-f0-9]{64}$"
+        }
+      }
+    },
+    "environment": {
+      "type": "object",
+      "required": ["runtime", "platform", "architecture", "isolation", "observation"],
+      "properties": {
+        "runtime": { "type": "string", "minLength": 1 },
+        "platform": { "type": "string", "minLength": 1 },
+        "architecture": { "type": "string", "minLength": 1 },
+        "isolation": { "type": "string", "minLength": 1 },
+        "observation": { "enum": ["caller-supplied", "runtime-observed"] }
+      }
+    },
+    "measurement_source": { "enum": ["caller-supplied", "runtime-observed"] },
+    "repetitions": { "type": "integer", "minimum": 1, "maximum": 1000 },
+    "execution": {
+      "type": "object",
+      "required": ["requested_repetitions", "completed_repetitions", "failed_repetitions", "warmup_repetitions", "synchronous", "fail_fast"],
+      "properties": {
+        "requested_repetitions": { "type": "integer", "minimum": 1, "maximum": 1000 },
+        "completed_repetitions": { "type": "integer", "minimum": 0, "maximum": 1000 },
+        "failed_repetitions": { "type": "integer", "minimum": 0, "maximum": 1000 },
+        "warmup_repetitions": { "type": "integer", "minimum": 0, "maximum": 100 },
+        "synchronous": { "const": true },
+        "fail_fast": { "type": "boolean" }
+      }
+    },
+    "samples": {
+      "type": "array",
+      "maxItems": 1000,
+      "items": {
+        "type": "object",
+        "required": ["index", "status", "duration_ms", "observed_heap_delta_bytes", "output_bytes", "metrics"],
+        "properties": {
+          "index": { "type": "integer", "minimum": 0 },
+          "status": { "enum": ["PASS", "FAIL"] },
+          "duration_ms": { "type": "number", "minimum": 0 },
+          "observed_heap_delta_bytes": { "type": "number", "minimum": 0 },
+          "output_bytes": { "type": "number", "minimum": 0 },
+          "metrics": { "type": "object", "additionalProperties": { "type": "number" } }
+        }
+      }
+    },
+    "measurements": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "number" } },
+    "budgets": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0 } },
+    "checks": { "type": "array", "minItems": 1 },
+    "failures": { "type": "array", "maxItems": 1000 },
+    "status": { "enum": ["PASS", "FAIL"] },
+    "scope": { "type": "string", "minLength": 1 },
+    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
+  }
+}
