+        "human_judgments": {
+          "type": "array",
+          "maxItems": 128,
+          "uniqueItems": true,
+          "items": { "type": "string", "minLength": 1, "maxLength": 160 }
+        },
+        "assurance_ceiling": { "type": "string", "minLength": 1, "maxLength": 240 }
+      },
+      "additionalProperties": false
+    },
+    "mutability": { "enum": ["immutable", "versioned"] },
+    "digest": { "$ref": "#/$defs/digest" }
+  },
+  "allOf": [
+    {
+      "if": { "properties": { "kind": { "const": "adapter" } }, "required": ["kind"] },
+      "then": { "required": ["adapter"] }
+    }
+  ],
+  "$defs": {
+    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
+    "port": {
+      "type": "object",
+      "required": ["id", "type", "required", "multiple"],
+      "properties": {
+        "id": {
+          "type": "string",
+          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
+          "maxLength": 100
+        },
+        "type": { "type": "string", "minLength": 1, "maxLength": 120 },
+        "required": { "type": "boolean" },
+        "multiple": { "type": "boolean" },
+        "description": { "type": "string", "maxLength": 300 }
+      },
+      "additionalProperties": false
+    }
+  },
+  "additionalProperties": false
+}
diff --git a/capabilities/platform-hands/shared/asset-hands/upgrade-program/NEXT_ROADMAP.md b/capabilities/platform-hands/shared/asset-hands/upgrade-program/NEXT_ROADMAP.md
