@@ -0,0 +1,49 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "axm.missing-asset-hand-catalog/v1",
+  "title": "AXM Missing Asset Hand Catalog",
+  "type": "object",
+  "required": ["schema", "version", "entries"],
+  "properties": {
+    "schema": { "const": "axm.missing-asset-hand-catalog/v1" },
+    "version": { "type": "string", "minLength": 1 },
+    "entries": {
+      "type": "array",
+      "items": { "$ref": "#/$defs/entry" }
+    }
+  },
+  "additionalProperties": false,
+  "$defs": {
+    "stringList": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
+    "profile": {
+      "type": "object",
+      "required": ["mediums", "units", "colour_spaces", "behaviours", "intended_uses"],
+      "properties": {
+        "mediums": { "$ref": "#/$defs/stringList" },
+        "units": { "$ref": "#/$defs/stringList" },
+        "colour_spaces": { "$ref": "#/$defs/stringList" },
+        "behaviours": { "$ref": "#/$defs/stringList" },
+        "intended_uses": { "$ref": "#/$defs/stringList" }
+      },
+      "additionalProperties": false
+    },
+    "entry": {
+      "type": "object",
+      "required": ["id", "title", "priority", "summary", "why_missing", "unblock_conditions", "operation_modes", "output_types", "canvas_profiles", "planned_constraints", "dependencies"],
+      "properties": {
+        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
+        "title": { "type": "string", "minLength": 1 },
+        "priority": { "enum": ["P0", "P1", "P2", "P3"] },
+        "summary": { "type": "string", "minLength": 1 },
+        "why_missing": { "type": "string", "minLength": 1 },
+        "unblock_conditions": { "$ref": "#/$defs/stringList" },
+        "operation_modes": { "$ref": "#/$defs/stringList" },
+        "output_types": { "$ref": "#/$defs/stringList" },
+        "canvas_profiles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/profile" } },
+        "planned_constraints": { "$ref": "#/$defs/stringList" },
+        "dependencies": { "$ref": "#/$defs/stringList" }
+      },
+      "additionalProperties": false
+    }
+  }
+}
