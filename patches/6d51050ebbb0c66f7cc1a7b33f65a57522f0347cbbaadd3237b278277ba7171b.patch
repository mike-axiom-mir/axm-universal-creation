+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "axm.universal-component/v1",
+  "title": "AXM Universal Component Protocol component v1",
+  "description": "An immutable or explicitly versioned, canvas-aware building block that can be referenced by recipes and composition graphs without embedding an executable identity.",
+  "type": "object",
+  "required": [
+    "schema",
+    "id",
+    "version",
+    "kind",
+    "title",
+    "ports",
+    "canvas_compatibility",
+    "capabilities",
+    "artifact_refs",
+    "payload",
+    "provenance",
+    "resource_profile",
+    "verification",
+    "mutability",
+    "digest"
+  ],
+  "properties": {
+    "schema": { "const": "axm.universal-component/v1" },
+    "id": {
+      "type": "string",
+      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
+      "maxLength": 160
+    },
+    "version": { "type": "string", "minLength": 1, "maxLength": 40 },
+    "kind": {
+      "type": "string",
+      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
+      "maxLength": 100
+    },
+    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
+    "description": { "type": "string", "maxLength": 1000 },
+    "ports": {
+      "type": "object",
+      "required": ["inputs", "outputs"],
+      "properties": {
+        "inputs": {
+          "type": "array",
+          "maxItems": 128,
+          "items": { "$ref": "#/$defs/port" }
+        },
+        "outputs": {
+          "type": "array",
+          "maxItems": 128,
+          "items": { "$ref": "#/$defs/port" }
+        }
+      },
+      "additionalProperties": false
+    },
+    "canvas_compatibility": {
+      "type": "object",
+      "required": ["mediums", "intended_uses", "constraints"],
+      "properties": {
+        "mediums": {
+          "type": "array",
+          "minItems": 1,
+          "maxItems": 32,
+          "uniqueItems": true,
+          "items": { "type": "string", "minLength": 1, "maxLength": 80 }
+        },
+        "intended_uses": {
+          "type": "array",
+          "minItems": 1,
+          "maxItems": 64,
+          "uniqueItems": true,
+          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
+        },
+        "constraints": {
+          "type": "array",
+          "maxItems": 128,
+          "uniqueItems": true,
+          "items": { "type": "string", "minLength": 1, "maxLength": 120 }
