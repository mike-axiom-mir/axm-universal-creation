+        "gpu": { "enum": ["none", "light", "medium", "heavy"] },
+        "peak_memory_bytes": { "type": ["integer", "null"], "minimum": 0 },
+        "working_storage_bytes": { "type": ["integer", "null"], "minimum": 0 },
+        "native_runtime": { "type": ["string", "null"], "maxLength": 120 }
+      },
+      "additionalProperties": false
+    },
+    "verification": {
+      "type": "object",
+      "required": ["automatic_checks", "human_judgments", "assurance_ceiling"],
+      "properties": {
