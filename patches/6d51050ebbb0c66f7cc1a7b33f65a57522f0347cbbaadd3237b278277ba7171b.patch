+  "title": "AXM Asset Hands fifty-upgrade program",
+  "type": "object",
+  "required": ["schema", "version", "status", "objective", "admission_rule", "upgrades"],
+  "properties": {
+    "schema": { "const": "axm.asset-hands.upgrade-program/v1" },
+    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
