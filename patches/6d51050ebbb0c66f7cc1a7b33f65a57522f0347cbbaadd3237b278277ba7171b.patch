+      "additionalProperties": false
+    },
+    "outputs": {
+      "type": "object",
+      "required": ["css", "svg", "tokens"],
+      "properties": {
+        "css": { "type": "boolean" },
+        "svg": { "type": "boolean" },
+        "tokens": { "const": true }
+      },
+      "additionalProperties": false
+    },
+    "target_canvas": { "type": "object" },
+    "portability": {
+      "type": "object",
+      "properties": {
+        "adapters_required": { "type": "array", "items": { "type": "string" } },
+        "known_limits": { "type": "array", "items": { "type": "string" } }
