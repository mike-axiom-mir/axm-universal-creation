+      "type": "object",
+      "required": ["from_types", "to_types", "required_hand", "known_losses"],
+      "properties": {
+        "from_types": {
+          "type": "array",
+          "minItems": 1,
+          "uniqueItems": true,
+          "items": { "type": "string", "minLength": 1, "maxLength": 120 }
+        },
+        "to_types": {
+          "type": "array",
+          "minItems": 1,
+          "uniqueItems": true,
+          "items": { "type": "string", "minLength": 1, "maxLength": 120 }
+        },
+        "required_hand": { "type": "string", "minLength": 1, "maxLength": 120 },
