+{
+  "capabilities": [
+    {
+      "id": "asset.performance.runtime-measure",
+      "status": "available",
+      "constraints": ["synchronous Node workloads", "1-1000 measured repetitions", "0-100 warmups", "heap sampled at repetition boundaries", "public Asset Hands registry route retains only a local function digest in its recipe"]
+    },
+    {
+      "id": "asset.performance.environment-bind",
+      "status": "available",
+      "constraints": ["runtime, platform and architecture observed from the executing Node host"]
+    },
+    {
+      "id": "asset.performance.failure-receipt",
+      "status": "available",
+      "constraints": ["bounded name and message", "no stack or private path retention", "fail-fast by default"]
+    },
+    {
+      "id": "asset.performance.receipt-schema",
+      "status": "available",
+      "constraints": ["axm.asset-hand-benchmark-receipt/v1", "implementation version 1.1.0"]
+    },
+    {
+      "id": "asset.performance.budget-check",
+      "status": "available",
+      "constraints": ["named numeric upper bounds", "missing measurements fail their budget check"]
+    }
+  ]
+}
