+    "runtime": { "type": ["object", "null"] },
+    "executor": { "type": ["object", "null"] },
+    "report": { "type": ["object", "null"] },
+    "checks": { "type": "array", "items": { "type": "object" } },
+    "scope": { "type": "array", "items": { "type": "string" } },
+    "authority": { "const": "external-validator-required" },
