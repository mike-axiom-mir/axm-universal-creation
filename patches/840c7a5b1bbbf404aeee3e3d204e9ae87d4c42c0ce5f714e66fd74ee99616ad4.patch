+            with self.subTest(mutate=mutate), self.assertRaises(ValueError): GamePoseAsset(encode(d, self.binary))
+
+    def test_nonfinite_zero_rotation_and_nonmonotonic_keys_rejected(self):
+        for value in (0., -1., float("nan")):
