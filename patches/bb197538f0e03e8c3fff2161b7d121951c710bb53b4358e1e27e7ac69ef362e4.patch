+        "schema": SCHEMA,
+        "id": template_id,
+        "version": 1,
+        "name": name,
+        "kind": "screen",
+        "domain": domain,
+        "tags": list(tags or []),
+        "origin": _origin(),
+        "style": style,
+        "intent": intent,
+        "variants": {variant: {region: list(box) for region, box in regions.items()} for variant, regions in variants.items()},
+        "slots": deepcopy(slots or []),
+        "math_hooks": deepcopy(math_hooks or {}),
+        "quality": list(quality or []),
+    }
+
